{
  "name": "@jd/wikiskill",
  "version": "0.1.0",
  "description": "Standalone WikiSkill evolution engine",
  "type": "commonjs",
  "main": "./src/standalone-client.js",
  "types": "./src/standalone-client.d.cts",
  "exports": {
    ".": {
      "types": "./src/standalone-client.d.cts",
      "default": "./src/standalone-client.js"
    }
  },
  "files": [
    "acceptance",
    "bin",
    "docs",
    "examples",
    "fixtures",
    "skills",
    "src",
    "README.md"
  ],
  "bin": {
    "wikiskill": "bin/wikiskill"
  },
  "scripts": {
    "acceptance": "node acceptance/black-box.js",
    "demo:check": "node examples/cli-config-evolution/scripts/run-live.cjs --dry-run",
    "demo:live": "node examples/cli-config-evolution/scripts/run-live.cjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}
